<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Authors>Martin Larsson</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Ayern72/MLCalc</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Ayern72/MLCalc</PackageProjectUrl>
		<PackageTags>mlcalc;calculator;complex;matrix;interpreter</PackageTags>
	</PropertyGroup>

	<!--
		NuGet packages: the libraries are packable, the applications and tests are not. The packages
		workflow (.github/workflows/packages.yml) adds a pre-release suffix to this version.
	-->
	<PropertyGroup>
		<VersionPrefix>0.1.0</VersionPrefix>
		<!-- Source Link: the package records the commit, and debuggers fetch the sources from GitHub. -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!-- The symbols go inside the DLL; GitHub Packages does not take separate symbol packages. -->
		<DebugType>embedded</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>
</Project>
