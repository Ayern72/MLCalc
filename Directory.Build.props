<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Authors>Martin Larsson</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Ayern72/MLCalc</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Ayern72/MLCalc</PackageProjectUrl>
	</PropertyGroup>

	<!--
		The libraries in src/ ship in the packages, so every public type and member must have an XML
		comment (CS1591). The applications (desktop, command line, web server and web client), tests
		and tools are exempt. The applications are matched by folder, because the WPF build also
		compiles a temporary project with another name. Decided here rather than in
		Directory.Build.targets: MSBuild reads NoWarn while evaluating the props.
	-->
	<PropertyGroup Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/')) or $(MSBuildProjectDirectory.EndsWith('MLCalc.Cli')) or $(MSBuildProjectDirectory.EndsWith('MLCalc.Wpf')) or $(MSBuildProjectDirectory.EndsWith('MLCalc.Web.Server')) or $(MSBuildProjectDirectory.EndsWith('MLCalc.Web.Client'))">
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<!--
		NuGet packages; see also Directory.Build.targets. The packages workflow
		(.github/workflows/packages.yml) adds a pre-release suffix to this version.
	-->
	<PropertyGroup>
		<VersionPrefix>0.1.0</VersionPrefix>
		<PackageIcon>icon.png</PackageIcon>
		<!-- Source Link: the package records the commit, and debuggers fetch the sources from GitHub. -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!--
			The symbols (PDB) go inside each DLL rather than in a separate .snupkg symbol package:
			GitHub Packages does not accept symbol packages, and embedded symbols reach every user of
			the package without a symbol server.
		-->
		<DebugType>embedded</DebugType>
	</PropertyGroup>
</Project>
