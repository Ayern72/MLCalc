<Window x:Class="MLCalc.Wpf.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:MLCalc.Wpf"
		Title="MLCalc" Width="1100" Height="820" MinWidth="500" MinHeight="400"
		AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
	<Window.InputBindings>
		<KeyBinding Gesture="Ctrl+O" Command="{x:Static local:MainWindow.RunScriptCommand}" />
		<KeyBinding Gesture="Ctrl+L" Command="{Binding ClearConsoleCommand}" />
	</Window.InputBindings>
	<Window.CommandBindings>
		<CommandBinding Command="{x:Static local:MainWindow.RunScriptCommand}" Executed="OnRunScript" />
		<CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
	</Window.CommandBindings>

	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="_Run Script…" InputGestureText="Ctrl+O" Command="{x:Static local:MainWindow.RunScriptCommand}" />
				<Separator />
				<MenuItem Header="E_xit" Click="OnExit" />
			</MenuItem>
			<MenuItem Header="_Edit">
				<MenuItem Header="_Copy Output" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Output}" />
				<MenuItem Header="_Stop Script" InputGestureText="Esc" Command="{Binding CancelCommand}" />
			</MenuItem>
			<MenuItem Header="_View">
				<MenuItem Header="Clear _Console" InputGestureText="Ctrl+L" Command="{Binding ClearConsoleCommand}" />
				<MenuItem Header="Reset _Plots" Command="{Binding ResetPlotsCommand}" />
			</MenuItem>
			<MenuItem Header="_Help">
				<MenuItem Header="List _Functions" Command="{Binding ListFunctionsCommand}" />
			</MenuItem>
		</Menu>

		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>
				<TextBlock Text="{Binding Status}" />
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<TextBlock Text="{Binding Coordinates}" FontFamily="{StaticResource ConsoleFont}" />
			</StatusBarItem>
		</StatusBar>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" MinHeight="120" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="280" MinHeight="90" />
			</Grid.RowDefinitions>

			<local:PlotView x:Name="Plot" Grid.Row="0" Figure="{Binding Figure}" />

			<GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DDD" ResizeBehavior="PreviousAndNext" />

			<DockPanel Grid.Row="2" Background="#FAFAFA">
				<DockPanel DockPanel.Dock="Bottom" Margin="4,2,4,4">
					<TextBlock DockPanel.Dock="Left" Text="{Binding Prompt}" FontFamily="{StaticResource ConsoleFont}" FontSize="14"
							VerticalAlignment="Center" Margin="2,0,6,0" Foreground="#1F77B4" />
					<TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
							FontFamily="{StaticResource ConsoleFont}" FontSize="14" Padding="2"
							PreviewKeyDown="OnInputKeyDown" AutomationProperties.Name="Input" />
				</DockPanel>

				<ListBox x:Name="Output" ItemsSource="{Binding Entries}" FontFamily="{StaticResource ConsoleFont}" FontSize="13"
						SelectionMode="Extended" BorderThickness="0" Background="Transparent"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
						ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Output">
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="4,0" />
						</Style>
					</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate DataType="{x:Type local:ConsoleEntry}">
							<TextBlock x:Name="Line" Text="{Binding Text}" />
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding Kind}" Value="Input">
									<Setter TargetName="Line" Property="Foreground" Value="#1F77B4" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Kind}" Value="Error">
									<Setter TargetName="Line" Property="Foreground" Value="#C62828" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Kind}" Value="Info">
									<Setter TargetName="Line" Property="Foreground" Value="#777" />
									<Setter TargetName="Line" Property="FontStyle" Value="Italic" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Grid>
	</DockPanel>
</Window>
