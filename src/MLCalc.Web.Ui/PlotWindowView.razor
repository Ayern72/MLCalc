@using System.Globalization
@using MLCalc.Plotting
@implements IDisposable
@inject IJSRuntime JS

@* One plot window, drawn as SVG with the same code as the desktop app's SVG export. A transparent
   layer on top takes the mouse, so that positions are measured from the window's corner. In a 3D
   window, dragging turns the camera and the wheel moves it closer or further away, as in the
   desktop app; on a touch screen, one finger turns and two fingers pinch to move closer or further
   away. While it moves, large items are drawn thinned out. *@
<div class="plot-window">
	@svg
	<div class="plot-mouse @(Is3D ? "turnable" : "")" @ref="mouse"
		@onpointerdown="OnPointerDownAsync" @onpointermove="OnPointerMove"
		@onpointerup="OnPointerUpAsync" @onpointercancel="OnPointerUpAsync"
		@onwheel="OnWheel" @onwheel:preventDefault="Is3D"
		@ondblclick="OnDoubleClick" @onmouseleave="OnMouseLeave"></div>
</div>

@code {
	/// <summary>How long after the last wheel turn the full view is drawn and sent.</summary>
	static readonly TimeSpan WheelSettle = TimeSpan.FromMilliseconds(250);

	ElementReference mouse;
	MarkupString svg;
	Axes? drawnAxes;
	double drawnWidth, drawnHeight;
	bool drawnCurrent;
	bool redraw = true;

	/// <summary>The window with the camera the user is turning; null when the window is as given.</summary>
	Axes? turned;

	/// <summary>A drag in progress: the angles and pointer position where it began.</summary>
	(Axes Start, double Azimuth, double Elevation, double X, double Y, long Pointer)? drag;

	/// <summary>The fingers on a 3D window, by pointer id, where they are now.</summary>
	readonly Dictionary<long, (double X, double Y)> touches = [];

	/// <summary>A pinch in progress: the window and the distance between the two fingers when it began.</summary>
	(Axes Start, double Distance)? pinch;

	CancellationTokenSource? wheelSettle;

	[Parameter, EditorRequired] public Axes Axes { get; set; } = null!;
	[Parameter] public int Row { get; set; }
	[Parameter] public int Column { get; set; }
	[Parameter] public string GridLabel { get; set; } = "";
	[Parameter] public bool IsCurrent { get; set; }
	[Parameter] public double Width { get; set; }
	[Parameter] public double Height { get; set; }

	/// <summary>Gets the status bar text for the mouse; a plain delegate, so that moving the mouse redraws only the status bar.</summary>
	[Parameter] public Action<string>? OnStatus { get; set; }

	/// <summary>Gets the camera (row, column, camera) after the user turned, zoomed or reset a 3D window.</summary>
	[Parameter] public Action<int, int, Camera>? OnCamera { get; set; }

	/// <summary>How far a 3D window is thinned out while it is turned; null for the plot model's own limits.</summary>
	[Parameter] public PreviewLimits? Preview { get; set; }

	Axes Shown => turned ?? Axes;

	bool Is3D => Axes.Kind == AxesKind.Space;

	ScreenRect Cell => new(0, 0, Width, Height);

	/// <summary>Draws again only when the window, its size or its frame changed.</summary>
	protected override void OnParametersSet()
	{
		if (ReferenceEquals(Axes, drawnAxes) && Width == drawnWidth && Height == drawnHeight && IsCurrent == drawnCurrent)
			return;
		// The window as the user left it, now confirmed by the page: already drawn.
		bool confirmed = turned is not null && drag is null && pinch is null && wheelSettle is null
			&& Axes.Camera == turned.Camera && Axes.Items == turned.Items
			&& Width == drawnWidth && Height == drawnHeight && IsCurrent == drawnCurrent;
		turned = null;
		drag = null;
		pinch = null;
		drawnAxes = Axes;
		if (!confirmed)
			Draw(Axes, preview: false);
	}

	void Draw(Axes axes, bool preview)
	{
		(drawnWidth, drawnHeight, drawnCurrent) = (Width, Height, IsCurrent);
		redraw = true;
		svg = Width >= 1 && Height >= 1
			? new MarkupString(SvgWriter.RenderWindow(preview && Preview is { } limits ? Scene3D.Preview(axes, limits.GridLines, limits.Points) : axes,
				Width, Height, $"w{Row}{Column}", IsCurrent, preview))
			: default;
	}

	/// <summary>Skips rendering when the drawing is unchanged, e.g. when only the console got new output.</summary>
	protected override bool ShouldRender()
	{
		bool result = redraw;
		redraw = false;
		return result;
	}

	async Task OnPointerDownAsync(PointerEventArgs e)
	{
		if (!Is3D || e.Button != 0)
			return;
		// Keep getting the pointer's moves when it leaves the window during the drag or pinch.
		await JS.InvokeVoidAsync("mlcalc.capturePointer", mouse, e.PointerId);
		if (e.PointerType == "touch")
		{
			touches[e.PointerId] = (e.ClientX, e.ClientY);
			if (touches.Count == 2)
			{
				// A second finger: the turn becomes a pinch, from the view as it is now.
				drag = null;
				pinch = (Shown, FingerDistance());
				return;
			}
			if (touches.Count > 2 || pinch is not null)
				return;
		}
		var (azimuth, elevation) = Projection3D.ViewAngles(Shown);
		drag = (Shown, azimuth, elevation, e.ClientX, e.ClientY, e.PointerId);
	}

	/// <summary>The distance between the first two fingers on the window, in pixels.</summary>
	double FingerDistance()
	{
		var fingers = touches.Values.Take(2).ToArray();
		return Math.Max(1, Math.Sqrt(Math.Pow(fingers[0].X - fingers[1].X, 2) + Math.Pow(fingers[0].Y - fingers[1].Y, 2)));
	}

	void OnPointerMove(PointerEventArgs e)
	{
		if (touches.ContainsKey(e.PointerId))
			touches[e.PointerId] = (e.ClientX, e.ClientY);
		if (pinch is { } p)
		{
			if (touches.Count < 2)
				return;
			// Fingers apart: closer. Measured from the start, so that the steps do not add up errors.
			turned = CameraControl.Zoom(p.Start, p.Distance / FingerDistance(), Cell);
			Draw(turned, preview: true);
			OnStatus?.Invoke(GridLabel + CameraControl.Describe(turned, Cell));
			return;
		}
		if (drag is not { } d)
		{
			OnStatus?.Invoke(Describe(e.OffsetX, e.OffsetY));
			return;
		}
		if (e.PointerId != d.Pointer)
			return;
		var (azimuth, elevation) = CameraControl.Drag(d.Azimuth, d.Elevation, e.ClientX - d.X, e.ClientY - d.Y);
		if (turned is not null && turned.Camera.Azimuth == azimuth && turned.Camera.Elevation == elevation)
			return;
		turned = CameraControl.Turn(d.Start, azimuth, elevation);
		Draw(turned, preview: true);
		OnStatus?.Invoke(GridLabel + CameraControl.Describe(turned, Cell));
	}

	async Task OnPointerUpAsync(PointerEventArgs e)
	{
		bool wasTouch = touches.Remove(e.PointerId);
		if (pinch is not null)
		{
			await JS.InvokeVoidAsync("mlcalc.releasePointer", mouse, e.PointerId);
			// The pinch ends when a finger is lifted; the finger left on the window does not turn
			// the view, which would jump from where the pinch began.
			pinch = null;
			if (turned is not null)
				Commit();
			return;
		}
		if (drag is not { } d || d.Pointer != e.PointerId)
		{
			if (wasTouch)
				await JS.InvokeVoidAsync("mlcalc.releasePointer", mouse, e.PointerId);
			return;
		}
		drag = null;
		await JS.InvokeVoidAsync("mlcalc.releasePointer", mouse, d.Pointer);
		if (turned is not null)
			Commit();
	}

	void OnWheel(WheelEventArgs e)
	{
		if (!Is3D || drag is not null)
			return;
		// Browsers give pixels (about 100 per notch) or, with DeltaMode 1, lines (3 per notch); the
		// desktop's wheel gives 120 per notch, positive away from the user.
		double notches = e.DeltaMode == 1 ? e.DeltaY / 3 : e.DeltaY / 100;
		if (notches == 0)
			return;
		turned = CameraControl.Zoom(Shown, CameraControl.WheelFactor((int)Math.Round(-notches * 120)), Cell);
		Draw(turned, preview: true);
		OnStatus?.Invoke(GridLabel + CameraControl.Describe(turned, Cell));
		_ = SettleAsync();
	}

	/// <summary>Draws the full view and sends the camera once the wheel has been still for a moment.</summary>
	async Task SettleAsync()
	{
		wheelSettle?.Cancel();
		var settle = wheelSettle = new CancellationTokenSource();
		try
		{
			await Task.Delay(WheelSettle, settle.Token);
		}
		catch (OperationCanceledException)
		{
			return;
		}
		wheelSettle = null;
		if (turned is not null)
		{
			Commit();
			StateHasChanged();
		}
	}

	void OnDoubleClick()
	{
		if (!Is3D)
			return;
		turned = Shown with { Camera = Camera.Default };
		Commit();
		OnStatus?.Invoke(GridLabel + CameraControl.Describe(turned, Cell));
	}

	/// <summary>Draws the window in full with the new camera and hands the camera to the page.</summary>
	void Commit()
	{
		Draw(turned!, preview: false);
		OnCamera?.Invoke(Row, Column, turned!.Camera);
	}

	void OnMouseLeave()
	{
		if (drag is null)
			OnStatus?.Invoke("");
	}

	/// <summary>The status bar text for the mouse at (x, y) in the window, as in the desktop app.</summary>
	string Describe(double x, double y)
	{
		if (Is3D)
			// A point on the screen is a whole line of points in 3D; show the camera instead.
			return GridLabel + CameraControl.Describe(Shown, Cell);
		var plot = PlotLayout.PlotArea(Cell);
		if (x < plot.Left || x > plot.Right || y < plot.Top || y > plot.Bottom)
			return "";
		var t = new PlotTransform(Axes, plot);
		string worldX = t.ToWorldX(x).ToString("G5", CultureInfo.InvariantCulture);
		string worldY = t.ToWorldY(y).ToString("G5", CultureInfo.InvariantCulture);
		return Axes.Kind == AxesKind.Complex ? $"{GridLabel}Re = {worldX}   Im = {worldY}" : $"{GridLabel}x = {worldX}   y = {worldY}";
	}

	public void Dispose() => wheelSettle?.Cancel();
}
