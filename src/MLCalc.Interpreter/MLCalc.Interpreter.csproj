<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>MLCalc.Scripting</PackageId>
		<Description>An embeddable interpreter for the MLCalc calculator language: complex matrices, variables, if/while/for, numerical analysis on functions given as text, and an API for adding functions and commands.</Description>
		<PackageTags>interpreter;scripting;expression-evaluator;calculator;math;matrix;complex-numbers</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\MLCalc.Numerics\MLCalc.Numerics.csproj" />
		<!-- Carried in this package; see Directory.Build.targets. -->
		<ProjectReference Include="..\MLCalc.Language\MLCalc.Language.csproj" Bundle="true" PrivateAssets="all" />
		<!-- Not dependencies of the package: they come with MLCalc.Numerics. -->
		<ProjectReference Include="..\MLCalc.Mathematics\MLCalc.Mathematics.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\MLCalc.LinearAlgebra\MLCalc.LinearAlgebra.csproj" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="MLCalc.Interpreter.Tests" />
	</ItemGroup>
</Project>
